<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-simplicity</ToolCommandName>
    <PackageId>SimplicityTools.Cli</PackageId>
    <Description>Global CLI entry point for the Simplicity-First .NET Toolkit.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimplicityTools.Metrics\SimplicityTools.Metrics.csproj" />
    <ProjectReference Include="..\SimplicityTools.Filters\SimplicityTools.Filters.csproj" />
    <ProjectReference Include="..\SimplicityTools.Tca\SimplicityTools.Tca.csproj" />
    <ProjectReference Include="..\SimplicityTools.Analyzers\SimplicityTools.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
