<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>SimplicityTools.Metrics</PackageId>
    <Description>Core data model and snapshot collection primitives for the Simplicity-First .NET Toolkit.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" />
    <!-- Direct reference lifts the vulnerable 17.7.2 transitive from Workspaces.MSBuild (NU1903, GHSA-h4j7-5rxr-p4wc) -->
    <PackageReference Include="Microsoft.Build.Tasks.Core" ExcludeAssets="runtime" />
    <!-- Direct reference lifts the vulnerable 10.0.1 transitive from Build.Tasks.Core/Workspaces.MSBuild (NU1903) -->
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
  </ItemGroup>
</Project>
