<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>SimplicityTools.Analyzers</PackageId>
    <PackageType>Analyzer</PackageType>
    <Description>Roslyn analyzer package for Simplicity-First diagnostics.</Description>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnforceExtendedAnalyzerRules>false</EnforceExtendedAnalyzerRules>
    <!-- Symbols are embedded in the shipped assemblies; no loose pdb or snupkg. -->
    <DebugType>embedded</DebugType>
    <IncludeSymbols>false</IncludeSymbols>
    <Version>0.8.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Compile against the oldest Roslyn whose APIs the analyzers use so older SDK/VS hosts
      can load the shipped assemblies (CS9057). The dependency stays PrivateAssets-only; the
      package declares no NuGet dependencies.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.4.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive/SimplicityTools.Analyzers.props" Pack="true" PackagePath="buildTransitive/" />
    <None Include="buildTransitive/SimplicityTools.Analyzers.props" Pack="true" PackagePath="build/" />
  </ItemGroup>

  <!--
    Both the analyzer assembly and the code-fix assembly ship in analyzers/dotnet/cs of this
    single package, per the standard Roslyn analyzer/code-fix split. The code-fix project is
    built on demand here (a ProjectReference would be circular for build ordering) and its
    output packed alongside this assembly.
  -->
  <Target Name="PackRoslynAnalyzerArtifacts" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="../SimplicityTools.Analyzers.CodeFixes/SimplicityTools.Analyzers.CodeFixes.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);NoBuild=false">
      <Output TaskParameter="TargetOutputs" ItemName="_SimplicityCodeFixAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <None Include="@(_SimplicityCodeFixAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
