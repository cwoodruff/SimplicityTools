---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingPageTemplate from '../components/templates/LandingPageTemplate.astro';
import { analyzerPackageUrl, cliPackageUrl, repoUrl, withBase } from '../data/site';

const toolHighlights = [
  {
    eyebrow: 'CLI',
    title: 'Commands that scale from first run to CI',
    summary: 'Analyze, baseline, diff, budget, report, and watch all share one simple command surface.',
    href: withBase('/docs/commands/')
  },
  {
    eyebrow: 'Analyzers',
    title: 'Seven teach-first diagnostics',
    summary: 'SF0001-SF0007 make simplification visible in the IDE and build output before code review has to guess.',
    href: withBase('/analyzers/')
  },
  {
    eyebrow: 'Filters',
    title: 'Metrics that still tell you what to do next',
    summary: 'TwoAmTest, HalfRule, and PrimaryPathFirst turn raw numbers into a conversation teams can actually use.',
    href: withBase('/docs/filters/')
  },
  {
    eyebrow: 'Reports',
    title: 'Shareable HTML output',
    summary: 'Generate a self-contained report when terminal output is not the right artifact for the audience.',
    href: withBase('/docs/commands/report/')
  },
  {
    eyebrow: 'Libraries',
    title: 'Programmatic package composition',
    summary: 'Use Metrics, Filters, and Tca directly when you want the SimplicityTools contract inside your own tooling.',
    href: withBase('/docs/library-usage/')
  }
];

const adoptionPaths = [
  {
    eyebrow: 'First run',
    title: 'Getting started',
    summary: 'Install the CLI, run analyze, and learn the zero-config story before you add gates.',
    href: withBase('/getting-started/')
  },
  {
    eyebrow: 'Reference',
    title: 'Docs hub',
    summary: 'Jump straight to command pages, filter docs, configuration, and integration guidance.',
    href: withBase('/docs/')
  },
  {
    eyebrow: 'Architecture signal',
    title: 'Analyzer reference',
    summary: 'Use SF0001-SF0007 pages when you need exact rule behavior, examples, and code-fix details.',
    href: withBase('/analyzers/')
  }
];
---

<BaseLayout
  title="SimplicityTools for teams that want a cleaner default"
  description="SimplicityTools helps .NET teams measure complexity, protect improvements in CI, and teach better architectural trade-offs."
>
  <LandingPageTemplate
    eyebrow="Measure what slows delivery"
    title="Keep complexity visible before it turns into delivery drag."
    summary="SimplicityTools gives .NET teams a clean first run, teach-first diagnostics, and a path from local insight to CI regression gates without forcing a custom process on day one."
    actions={[
      { label: 'Browse docs', href: withBase('/docs/') },
      { label: 'Install the CLI', href: cliPackageUrl, variant: 'secondary', external: true },
      { label: 'View GitHub', href: repoUrl, variant: 'ghost', external: true }
    ]}
  >
    <section class="section">
      <div class="callout-panel">
        <span class="panel-label">The first five minutes</span>
        <pre><code>dotnet tool install --global SimplicityTools.Cli

dotnet simplicity analyze path/to/YourSolution.sln

dotnet simplicity diff path/to/YourSolution.sln --fail-on-regression</code></pre>
        <div class="pill-row">
          <span class="pill">Zero config by default</span>
          <span class="pill">Local first</span>
          <span class="pill">CI-ready</span>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <h2>Five surfaces, one contract</h2>
        <p>The tools reinforce each other. Start with a snapshot, teach the team what matters, then protect the gains instead of letting complexity creep back in.</p>
      </div>
      <div class="card-grid">
        {
          toolHighlights.map((tool) => (
            <a class="link-card" href={tool.href}>
              <span class="link-card__eyebrow">{tool.eyebrow}</span>
              <h3>{tool.title}</h3>
              <p>{tool.summary}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <h2>Adopt it in the order that lowers risk</h2>
        <p>Do not jump straight to policy. Learn the current shape first, capture the baseline second, then enforce regression only after the team agrees on the contract.</p>
      </div>
      <div class="command-grid">
        <div class="card">
          <h3>1. Learn the current shape</h3>
          <pre><code>dotnet simplicity analyze YourSolution.sln

dotnet simplicity budget YourSolution.sln</code></pre>
        </div>
        <div class="card">
          <h3>2. Protect the win</h3>
          <pre><code>dotnet simplicity baseline YourSolution.sln

dotnet simplicity diff YourSolution.sln --fail-on-regression</code></pre>
        </div>
      </div>
      <div class="button-row">
        <a class="button button--secondary" href={withBase('/getting-started/')}>Read the guided setup</a>
        <a class="button button--ghost" href={withBase('/integration/ci-cd/')}>See CI wiring</a>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <h2>Diagnostics that teach instead of nag</h2>
        <p>The analyzer package surfaces structural smells where developers already work. Use it when you want faster feedback than a pull request comment can provide.</p>
      </div>
      <div class="three-up">
        <div class="card">
          <h3>Install once</h3>
          <pre><code>dotnet add package SimplicityTools.Analyzers --prerelease</code></pre>
        </div>
        <div class="card">
          <h3>Keep the reference private</h3>
          <pre><code>&lt;PackageReference Include="SimplicityTools.Analyzers" Version="x.y.z" PrivateAssets="all" /&gt;</code></pre>
        </div>
        <div class="card">
          <h3>Learn the rules</h3>
          <p>Start with SF0001 and SF0002 if you want the quickest wins from the two available code fixes.</p>
        </div>
      </div>
      <div class="button-row">
        <a class="button" href={withBase('/analyzers/')}>Browse analyzer docs</a>
        <a class="button button--secondary" href={withBase('/integration/ide-setup/')}>IDE setup</a>
        <a class="button button--ghost" href={analyzerPackageUrl} target="_blank" rel="noreferrer">Analyzer package</a>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <h2>Choose the next page based on the job</h2>
        <p>Clear internal links matter more than cleverness. Start with the page that matches the decision you are making today.</p>
      </div>
      <div class="three-up">
        {
          adoptionPaths.map((path) => (
            <a class="link-card" href={path.href}>
              <span class="link-card__eyebrow">{path.eyebrow}</span>
              <h3>{path.title}</h3>
              <p>{path.summary}</p>
            </a>
          ))
        }
      </div>
    </section>
  </LandingPageTemplate>
</BaseLayout>
