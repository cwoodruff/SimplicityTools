---
import { withBase } from '../../data/site';
import ReferenceCodeBlock from './ReferenceCodeBlock.astro';
import type { AnalyzerDetail } from '../../data/reference-content';

interface Props {
  detail: AnalyzerDetail;
}

const { detail } = Astro.props;
---

<section class="section">
  <div class="section-heading">
    <h2>Diagnostic contract</h2>
    <p>{detail.whyItMatters}</p>
  </div>
  <div class="badge-row">
    <span class="diagnostic-badge">{detail.id}</span>
    <span class="diagnostic-badge diagnostic-badge--subtle">{detail.category}</span>
    <span class="diagnostic-badge diagnostic-badge--subtle">{detail.severity}</span>
    <span class="diagnostic-badge diagnostic-badge--subtle">{detail.codeFix ? 'Code fix available' : 'Advisory only'}</span>
  </div>
  <div class="reference-facts">
    <div>
      <span class="muted-label">When it fires</span>
      <p>{detail.whenItFiresSummary}</p>
    </div>
    <div>
      <span class="muted-label">Rule message</span>
      <p>{detail.ruleMessage}</p>
    </div>
    <div>
      <span class="muted-label">Help link target</span>
      <p><code>/analyzers/{detail.id.toLowerCase()}/</code></p>
    </div>
  </div>
</section>

<section class="section">
  <div class="section-heading">
    <h2>When it fires</h2>
    <p>These are the concrete cases to look for in code review and IDE diagnostics.</p>
  </div>
  <ul class="bullet-list">
    {detail.whenItFires.map((item) => <li>{item}</li>)}
  </ul>
</section>

<section class="section">
  <div class="section-heading">
    <h2>Bad / better example</h2>
    <p>Use these examples to explain the rule, not just silence it.</p>
  </div>
  <div class="reference-grid">
    <div class="card">
      <h3>Before</h3>
      <ReferenceCodeBlock code={detail.badExample.code} lang={detail.badExample.lang} />
      <p>{detail.badExample.caption}</p>
    </div>
    <div class="card">
      <h3>After</h3>
      <ReferenceCodeBlock code={detail.goodExample.code} lang={detail.goodExample.lang} />
      <p>{detail.goodExample.caption}</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="section-heading">
    <h2>Code fix</h2>
    <p>{detail.codeFix ? detail.codeFixSummary : 'There is no automatic code fix for this rule today. Treat it as a prompt to simplify deliberately.'}</p>
  </div>
  <ul class="bullet-list">
    {detail.codeFixNotes.map((item) => <li>{item}</li>)}
  </ul>
</section>

<section class="section">
  <div class="section-heading">
    <h2>Source and follow-up links</h2>
    <p>Use these links when you need to validate behavior against the source or connect the docs back to project tracking.</p>
  </div>
  <div class="reference-grid">
    <a class="link-card" href={detail.sourceHref} target="_blank" rel="noreferrer">
      <span class="link-card__eyebrow">Source</span>
      <h3>Analyzer implementation</h3>
      <p>{detail.sourceLabel}</p>
    </a>
    {detail.codeFixHref ? (
      <a class="link-card" href={detail.codeFixHref} target="_blank" rel="noreferrer">
        <span class="link-card__eyebrow">Code fix</span>
        <h3>Implementation details</h3>
        <p>{detail.codeFixLabel}</p>
      </a>
    ) : null}
    <a class="link-card" href={detail.issueHref} target="_blank" rel="noreferrer">
      <span class="link-card__eyebrow">Tracking</span>
      <h3>Issue #{detail.issueNumber}</h3>
      <p>Documentation tracker for the analyzer pages and related integration guidance.</p>
    </a>
    {detail.relatedLinks.map((link) => (
      <a class="link-card" href={withBase(link.href)}>
        <span class="link-card__eyebrow">{link.eyebrow}</span>
        <h3>{link.label}</h3>
        <p>{link.description}</p>
      </a>
    ))}
  </div>
</section>
