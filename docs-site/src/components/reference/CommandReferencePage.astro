---
import { withBase } from '../../data/site';
import ReferenceCodeBlock from './ReferenceCodeBlock.astro';
import type { CommandDetail } from '../../data/reference-content';

interface Props {
  detail: CommandDetail;
}

const { detail } = Astro.props;
---

<section class="section">
  <div class="section-heading">
    <h2>Command contract</h2>
    <p>{detail.purpose}</p>
  </div>
  <div class="reference-facts">
    <div>
      <span class="muted-label">Best for</span>
      <p>{detail.bestFor}</p>
    </div>
    <div>
      <span class="muted-label">Writes files</span>
      <p>{detail.writesFiles}</p>
    </div>
    <div>
      <span class="muted-label">Exit behavior</span>
      <p>{detail.exitBehavior}</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="section-heading">
    <h2>Usage</h2>
    <p>Start with the exact command shape the CLI supports today.</p>
  </div>
  <ReferenceCodeBlock code={detail.command} lang="bash" label="Command" />
  {
    detail.examples.length > 0 ? (
      <div class="reference-grid">
        {detail.examples.map((example) => (
          <div class="card">
            <h3>{example.label}</h3>
            <p>{example.description}</p>
            <ReferenceCodeBlock code={example.code} lang={example.lang} />
          </div>
        ))}
      </div>
    ) : null
  }
</section>

<section class="section">
  <div class="section-heading">
    <h2>What it prints or produces</h2>
    <p>{detail.outputIntro}</p>
  </div>
  <ul class="bullet-list">
    {detail.outputHighlights.map((item) => <li>{item}</li>)}
  </ul>
  {detail.sampleOutput ? <ReferenceCodeBlock code={detail.sampleOutput} lang="text" label="Sample output" /> : null}
</section>

<section class="section">
  <div class="section-heading">
    <h2>Operational notes</h2>
    <p>These behaviors matter when you move from a local run to team automation.</p>
  </div>
  <ul class="bullet-list">
    {detail.operationalNotes.map((item) => <li>{item}</li>)}
  </ul>
</section>

<section class="section">
  <div class="section-heading">
    <h2>Related pages</h2>
    <p>Use the surrounding docs when you need setup, filter interpretation, or CI context.</p>
  </div>
  <div class="reference-grid">
    {
      detail.relatedLinks.map((link) => (
        <a class="link-card" href={link.external ? link.href : withBase(link.href)} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>
          <span class="link-card__eyebrow">{link.eyebrow}</span>
          <h3>{link.label}</h3>
          <p>{link.description}</p>
        </a>
      ))
    }
  </div>
</section>
