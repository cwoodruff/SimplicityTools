<Project>
  <PropertyGroup>
    <SimplicityToolsReleaseVersion>0.8.0</SimplicityToolsReleaseVersion>
    <SimplicityToolsLocalPackageVersion>$(SimplicityToolsReleaseVersion)-local</SimplicityToolsLocalPackageVersion>

    <IsSimplicityPackage>false</IsSimplicityPackage>
    <IsSimplicityLibraryPackage>false</IsSimplicityLibraryPackage>

    <IsSimplicityPackage Condition="'$(MSBuildProjectName)' == 'SimplicityTools.Metrics'">true</IsSimplicityPackage>
    <IsSimplicityPackage Condition="'$(MSBuildProjectName)' == 'SimplicityTools.Filters'">true</IsSimplicityPackage>
    <IsSimplicityPackage Condition="'$(MSBuildProjectName)' == 'SimplicityTools.Tca'">true</IsSimplicityPackage>
    <IsSimplicityPackage Condition="'$(MSBuildProjectName)' == 'SimplicityTools.Analyzers'">true</IsSimplicityPackage>
    <IsSimplicityPackage Condition="'$(MSBuildProjectName)' == 'SimplicityTools.Cli'">true</IsSimplicityPackage>

    <IsSimplicityLibraryPackage Condition="'$(MSBuildProjectName)' == 'SimplicityTools.Metrics'">true</IsSimplicityLibraryPackage>
    <IsSimplicityLibraryPackage Condition="'$(MSBuildProjectName)' == 'SimplicityTools.Filters'">true</IsSimplicityLibraryPackage>
    <IsSimplicityLibraryPackage Condition="'$(MSBuildProjectName)' == 'SimplicityTools.Tca'">true</IsSimplicityLibraryPackage>

    <!-- Release gate from docs/distribution-plan.md: zero warnings. Debug builds stay permissive for local iteration. -->
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsSimplicityPackage)' == 'true'">
    <Authors>Chris Woody Woodruff</Authors>
    <Company>SimplicityTools</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cwoodruff/SimplicityTools/blob/main/docs/using-the-simplicity-tools.md</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cwoodruff/SimplicityTools</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>simplicitytools-icon.png</PackageIcon>
    <PackageTags>dotnet;complexity;architecture;roslyn;cli;analyzers;simplicity</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Version Condition="'$(Version)' == ''">$(SimplicityToolsLocalPackageVersion)</Version>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsSimplicityPackage)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Link="README.md" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)assets/nuget/simplicitytools-icon.png" Pack="true" PackagePath="\" Link="simplicitytools-icon.png" Visible="false" />
  </ItemGroup>
</Project>
